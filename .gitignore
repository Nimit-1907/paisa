# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/.playwright-mcp

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env files: keep the template committed
!.env.example

# serwist / generated service worker
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js

# playwright / browser automation scratch output
/.playwright-mcp

# Phase 10 before/after screenshots. Kept on disk as a reference for
# docs/design-review.md; not in history, where every revision of a PNG would
# live forever.
docs/screenshots/

# Playwright visual baselines, regenerated by running e2e/visual.spec.ts.
# Binaries do not belong in history; see docs/premium-pass.md.
e2e/visual.spec.ts-snapshots/
