# Copy to .env.local and fill in.
# For local dev, run `supabase start` and use the values it prints
# (API URL + anon key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Base URL used for auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verifies session tokens locally instead of a round trip to Auth on every
# page (src/lib/supabase/verify.ts). Server only, never NEXT_PUBLIC_.
# Local: `supabase status`. Hosted: Project Settings > JWT Keys > legacy
# secret. Leave empty on a project with asymmetric keys; getClaims() covers it.
SUPABASE_JWT_SECRET=

# "Continue with Google" (docs/auth-google.md). Leave false until the Google
# OAuth client exists; the button stays hidden while it is.
AUTH_GOOGLE=false
# Read by the Supabase CLI for [auth.external.google] in supabase/config.toml.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
